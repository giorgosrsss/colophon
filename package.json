{
  "name": "colophon",
  "productName": "Colophon",
  "version": "1.0.0",
  "description": "Read and edit the properties of Word documents, with a local AI-writing check.",
  "author": "George Roussos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/giorgosrsss/colophon.git"
  },
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "icon": "electron scripts/make-icon.cjs",
    "package": "node scripts/build.mjs && npm run models && node scripts/package.mjs",
    "models": "node --disable-warning=ExperimentalWarning scripts/get-models.mjs"
  },
  "dependencies": {
    "onnxruntime-node": "1.31.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xmldom/xmldom": "0.9.12",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "jszip": "3.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  }
}
